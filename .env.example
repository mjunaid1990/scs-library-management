# Copy to backend/.env (never commit the real file).

# --- Django ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=UTC
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Database: sqlite (default) or mysql ---
DB_ENGINE=sqlite
DB_NAME=scs_library
DB_USER=library
DB_PASSWORD=library
DB_HOST=127.0.0.1
DB_PORT=3306

# --- Email ---
# Development default is the console backend; use SMTP in production.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=library@example.edu
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true

# --- Links in invite / password-reset emails ---
FRONTEND_BASE_URL=http://localhost:5173

# --- Sessions ---
SESSION_COOKIE_AGE=28800
